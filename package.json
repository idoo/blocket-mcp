{
  "name": "blocket-mcp",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "build:stdio": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node20 --loader:.html=text --banner:js=\"#!/usr/bin/env node\" --outfile=dist/blocket-mcp.js",
    "build:mcpb": "scripts/build-mcpb.sh"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
