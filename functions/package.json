{
  "name": "blocket-mcp-firebase",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --loader:.html=text --external:firebase-functions --external:firebase-admin --outfile=lib/index.js",
    "check": "../node_modules/.bin/tsc -p . --noEmit",
    "gcp-build": ""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
