{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blocket-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "workers_dev": true,
  // Secret (not in this file): MCP_PATH_TOKEN — `npx wrangler secret put MCP_PATH_TOKEN`; local copy in .dev.vars.
  "observability": { "enabled": true }
}
