{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blocket-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "workers_dev": true,
  // Account-wide cap on MCP calls (the free plan shares 100k requests/day across all Workers).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4471", "simple": { "limit": 120, "period": 60 } }
  ],
  // Secret (not in this file): MCP_PATH_TOKEN — `npx wrangler secret put MCP_PATH_TOKEN`; local copy in .dev.vars.
  "observability": { "enabled": true }
}
